#!/usr/sbin/nft -f
# SPDX-FileCopyrightText: 2026 The Portitor contributors
# SPDX-License-Identifier: AGPL-3.0-or-later
flush ruleset
define LAN = 192.168.1.0/24
table inet filter {
  set blocked { type ipv4_addr; flags interval; elements = { 10.9.0.0/16, 1.2.3.4 } }
  set webports { type inet_service; elements = { 80, 443 } }
  chain input {
    type filter hook input priority 0; policy drop;
    ct state established,related accept
    ct state invalid drop
    iif lo accept
    iifname "eth1" ip saddr $LAN tcp dport { 22, 8000-8080 } accept comment "admin"
    ip saddr @blocked drop
    meta l4proto { tcp, udp } th dport 53 accept
    icmp type echo-request limit rate 5/second accept
    ip6 nexthdr icmpv6 icmpv6 type { nd-neighbor-solicit, echo-request } accept
    tcp dport @webports counter log prefix "web " accept
    iifname != "eth0" udp dport 123 reject
    jump custom
    iifname "eth1" goto lan_in
  }
  chain custom { tcp dport 9999 accept; }
  chain lan_in {
    udp dport 161 accept
    iifname "eth0" drop
    ip saddr 192.168.1.5 return
    tcp dport 25 accept
  }
  chain unused { tcp dport 1 accept; }
  chain forward { type filter hook forward priority 0; policy accept;
    oifname "eth0" ip6 daddr 2001:db8::/32 reject with icmpx admin-prohibited; }
}
table ip nat {
  chain prerouting { type nat hook prerouting priority -100;
    iifname "eth0" tcp dport 8443 dnat to 192.168.1.10:443
    iifname "eth0" udp dport { 5000-5010 } dnat to 192.168.1.11; }
  chain postrouting { type nat hook postrouting priority 100;
    oifname "eth0" ip saddr 192.168.1.0/24 masquerade
    oifname "eth2" snat to 203.0.113.5; }
}
