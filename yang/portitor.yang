module portitor {
  yang-version 1.1;
  namespace "urn:portitor:config";
  prefix pt;

  import portitor-extensions { prefix px; }

  include portitor-types;
  include portitor-system;
  include portitor-interfaces;
  include portitor-routing;
  include portitor-firewall;
  include portitor-services;
  include portitor-objects;
  include portitor-access;
  include portitor-state;

  organization "The Portitor contributors";
  contact "https://github.com/abundo/portitor";
  description
    "The configuration of a Portitor firewall, and of its cluster secondary:
     settings, virtual firewalls (instance) with their interfaces, routing,
     filter and NAT rules and services, links between them, the
     objects they share (hosts, address lists, IP lists, services), and
     what is the firewall's alone (syslog servers, certificate
     authorities, the DNS templates every virtual firewall may use).

     Every frontend reads and writes this tree: the CLI, NETCONF, the API
     and the GUI. The state (config false) is what the firewalls run
     and see: system, and each instance's state.";

  revision 2026-11-16 {
    description "1.1.0: the firewall's host (the default instance) is the top level
      (grouping host, host-name), not an instance; its lists' leafrefs to the top
      level's lists are absolute.";
  }
  revision 2026-11-08 { description "First version, from the SQLite schema."; }

  px:table "instances";
  uses system;
  uses host;
  uses objects;
  uses firewall-services;
  uses access;
  uses system-state;
}
