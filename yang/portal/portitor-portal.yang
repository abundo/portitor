module portitor-portal {
  yang-version 1.1;
  namespace "urn:portitor:portal";
  prefix pp;

  import portitor-extensions { prefix px; }

  organization "The Portitor contributors";
  contact "https://github.com/abundo/portitor";
  description
    "The configuration of portitor-web, the portal: the firewalls whose GUIs
     it serves, the witness strings of the HA pairs it is the witness of,
     and the users who may log in to the portal. What it needs to start
     (the listen address, TLS certificate and data directory) is in web.yaml.";

  revision 2026-11-15 { description "First version."; }

  grouping host {
    description "One host's portitor-config, as the portal reaches it.";
    leaf url {
      type string { pattern 'https?://[^/?#@\s]+/?'; }
      description "Its portitor-config: https://<host>:<port>.";
    }
    leaf fingerprint {
      type string { pattern '([0-9A-Fa-f]{2}:?){31}[0-9A-Fa-f]{2}'; }
      description "The SHA-256 of its portitor-config's tls_cert, pinned.";
    }
    leaf ssh-host-key {
      type string;
      description "The SSH host key (SHA256:...) of the host, as the administrator confirmed it when it was added.";
    }
  }

  list firewall {
    key "name";
    ordered-by user;
    description "A firewall: its portitor-config, served at /fw/<name>/, a tab of the portal.";
    leaf name {
      type string {
        length "1..63";
        pattern '[A-Za-z0-9][A-Za-z0-9._-]*';
      }
      description "Letters, digits, '-', '_' and '.', starting with a letter or digit.";
    }
    leaf description {
      type string;
    }
    leaf url {
      type string { pattern 'https?://[^/?#@\s]+/?'; }
      mandatory true;
      description "Its portitor-config: https://<host>:<port>; http:// to this host only.";
    }
    leaf fingerprint {
      type string { pattern '([0-9A-Fa-f]{2}:?){31}[0-9A-Fa-f]{2}'; }
      description "The SHA-256 of its portitor-config's tls_cert, pinned. Empty for http:// to this host.";
    }
    leaf ssh-host-key {
      type string;
      description "The SSH host key (SHA256:...) of the host, as the administrator confirmed it when the firewall was added.";
    }
  }

  list ha-firewall {
    key "name";
    ordered-by user;
    description
      "An HA pair, one firewall in the portal, served at /fw/<name>/ by
       whichever of its hosts is primary now. Its hosts are added one at a
       time; once both are there the portal pairs them (the secondary's
       information carried over SSH to the primary, add-secondary), unless
       they are a pair already. A name is a firewall's or an HA firewall's,
       never both.";
    leaf name {
      type string {
        length "1..63";
        pattern '[A-Za-z0-9][A-Za-z0-9._-]*';
      }
    }
    leaf description {
      type string;
    }
    leaf witness {
      type boolean;
      default true;
      description "Make this portal the pair's witness when it pairs the hosts.";
    }
    container primary {
      description "The host installed as the pair's primary.";
      uses host;
    }
    container secondary {
      description "The host installed as the pair's secondary (ISO role secondary).";
      uses host;
    }
  }

  list witness {
    key "pair";
    description "An HA pair this portal is the witness of.";
    leaf pair {
      type string { length "1..63"; }
    }
    leaf string {
      type string;
      mandatory true;
      px:secret;
      description "The pair's witness string (portitor-config witness-string): it holds the witness secret.";
    }
  }

  list user {
    key "name";
    description "A user of the portal.";
    leaf name {
      type string {
        length "1..64";
        pattern '[A-Za-z0-9][A-Za-z0-9._@-]*';
      }
    }
    leaf password-hash {
      type string;
      px:secret;
      description "The bcrypt hash of the password.";
    }
  }
}
