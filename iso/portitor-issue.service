# The interfaces and their addresses on the console's login screen.
[Unit]
Description=Portitor interfaces on the login screen
Before=getty.target

[Service]
ExecStart=/usr/sbin/portitor-issue
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
