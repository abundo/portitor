# First-boot answers for a test ISO (iso/build.sh --test), matching the
# virtual machine of iso/vm.sh: its second NIC is the LAN.
lan: 52:54:00:00:00:02
address: 192.168.1.1/24
gateway: 192.168.1.2
# QEMU's resolver on the LAN network
dns: 192.168.1.3
password: portitor-test
timezone: Europe/Stockholm
