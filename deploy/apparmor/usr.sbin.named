# BIND per Portitor instance (portitor-named@.service). The AppArmor profile
# for named on Debian/Ubuntu only allows /etc/bind, /var/lib/bind and
# /var/cache/bind; install.py adds these rules to the profile's local include
# (/etc/apparmor.d/local/usr.sbin.named). The path is the default of etc_dir
# in /etc/portitor/agent.yaml. The unit puts everything else in BIND's own
# directories (per instance, mounted over them), which the profile allows.
/etc/portitor/instances/*/named.conf* r,
