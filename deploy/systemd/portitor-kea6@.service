# Kea DHCPv6 for one Portitor instance, inside the instance's network
# namespace. Started and restarted by portitor-agent; do not enable by hand.
[Unit]
Description=Kea DHCPv6 server for Portitor instance %i
After=portitor-agent.service
PartOf=portitor-agent.service

[Service]
Type=simple
ExecStart=/usr/bin/portitor-agent netns-exec %i -- /usr/sbin/kea-dhcp6 -c /etc/portitor/instances/%i/kea-dhcp6.conf
Restart=on-failure
RestartSec=5
# Same directories as portitor-kea4@ (see there); the PID file names differ.
Environment=KEA_PIDFILE_DIR=/tmp
Environment=KEA_LOCKFILE_DIR=/run/kea
RuntimeDirectory=kea kea/%i
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
StateDirectory=kea kea/%i
StateDirectoryMode=0750
# Multitenancy: an instance's daemon sees only its own files and processes.
# The other instances' config and state are hidden, the rest of the system
# is read-only, and it gets its own /tmp, IPC and PID namespaces.
# netns-exec drops CAP_SYS_ADMIN and the like, so it can't enter another
# instance's network namespace either.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateIPC=yes
PrivatePIDs=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectProc=invisible
TemporaryFileSystem=/etc/portitor /var/lib/portitor
BindReadOnlyPaths=/etc/portitor/instances/%i
BindReadOnlyPaths=/var/lib/portitor/instances/%i
BindPaths=/var/lib/kea/%i:/var/lib/kea /run/kea/%i:/run/kea
