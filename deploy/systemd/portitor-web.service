[Unit]
Description=Portitor management GUI
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=portitor
Group=portitor
ExecStart=/usr/bin/portitor-web -f /etc/portitor/web.yaml start
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
# The SQLite database (db.path in web.yaml).
StateDirectory=portitor-web
StateDirectoryMode=0700

[Install]
WantedBy=multi-user.target
