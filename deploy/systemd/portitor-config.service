# portitor-config: the firewall's configuration, GUI and API (portitor-web
# run as portitor-config), deploying to the local agent and its HA peer.
[Unit]
Description=Portitor configuration of this firewall
After=network-online.target portitor-agent.service
Wants=network-online.target

[Service]
Type=simple
User=portitor
Group=portitor
ExecStart=/usr/bin/portitor-config -f /etc/portitor/config.yaml start
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
# Ports below 1024 (bind: 0.0.0.0:443, the ISO's); nothing else.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
# The SQLite database (db.path in config.yaml).
StateDirectory=portitor-config
StateDirectoryMode=0700

[Install]
WantedBy=multi-user.target
