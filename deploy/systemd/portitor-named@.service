# BIND for one Portitor instance, inside the instance's network namespace.
# Started and reloaded by portitor-agent; do not enable by hand.
[Unit]
Description=BIND DNS server for Portitor instance %i
After=portitor-agent.service
PartOf=portitor-agent.service

[Service]
Type=simple
# -u: the BIND user (bind on Debian/Ubuntu, named on Fedora/RHEL). Keep in
# step with bind_user in /etc/portitor/agent.yaml.
ExecStart=/usr/bin/portitor-agent netns-exec %i -- /usr/sbin/named -f -u bind -c /etc/portitor/instances/%i/named.conf
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5
RuntimeDirectory=portitor
RuntimeDirectoryPreserve=yes
