# Kea DHCPv4 for one Portitor instance, inside the instance's network
# namespace. Started and restarted by portitor-agent; do not enable by hand.
[Unit]
Description=Kea DHCPv4 server for Portitor instance %i
After=portitor-agent.service
PartOf=portitor-agent.service

[Service]
Type=simple
ExecStart=/usr/bin/portitor-agent netns-exec %i -- /usr/sbin/kea-dhcp4 -c /etc/portitor/instances/%i/kea-dhcp4.conf
Restart=on-failure
RestartSec=5
# Each instance has its own Kea directories, /var/lib/kea/%i and
# /run/kea/%i, mounted over /var/lib/kea and /run/kea (see the bind mounts
# below): one instance's Kea can't read another's leases or reach its
# control socket. Kea 2.6 refuses a control socket directory other than
# mode 0750. The logger's lock file goes there too, as
# /run/kea/logger_lockfile on the host may belong to Debian's own Kea. The
# PID file goes in the private /tmp, new at each start: Kea is always PID 1
# (PrivatePIDs), so a PID file left by an unclean stop would read as
# "already running".
Environment=KEA_PIDFILE_DIR=/tmp
Environment=KEA_LOCKFILE_DIR=/run/kea
RuntimeDirectory=kea kea/%i
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
StateDirectory=kea kea/%i
StateDirectoryMode=0750
# Multitenancy: an instance's daemon sees only its own files and processes.
# The other instances' config and state are hidden, the rest of the system
# is read-only, and it gets its own /tmp, IPC and PID namespaces.
# netns-exec drops CAP_SYS_ADMIN and the like, so it can't enter another
# instance's network namespace either.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateIPC=yes
PrivatePIDs=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectProc=invisible
TemporaryFileSystem=/etc/portitor /var/lib/portitor
BindReadOnlyPaths=/etc/portitor/instances/%i
BindReadOnlyPaths=/var/lib/portitor/instances/%i
BindPaths=/var/lib/kea/%i:/var/lib/kea /run/kea/%i:/run/kea
