# OpenVPN's server for one protocol (%j, udp or tcp, from the unit's name) for one
# Portitor instance, inside the instance's network namespace, on the tun
# device the agent made there. portitor-agent answers its logins through the
# management socket. Started and restarted by portitor-agent; do not enable
# by hand. portitor-openvpn-udp@ and portitor-openvpn-tcp@ are the same file.
[Unit]
Description=OpenVPN (%j) for Portitor instance %i
After=portitor-agent.service
PartOf=portitor-agent.service

[Service]
Type=simple
# Runs as root until it has its certificate, key and tun device, then as
# nobody (openvpn-%j.conf).
ExecStart=/usr/bin/portitor-agent netns-exec %i -- /usr/sbin/openvpn --suppress-timestamps --config /etc/portitor/instances/%i/openvpn-%j.conf
# Also while the certificate is being got: it starts once the file is there.
Restart=on-failure
RestartSec=5
LimitNPROC=10
RuntimeDirectory=portitor
RuntimeDirectoryPreserve=yes
# Multitenancy: an instance's daemon sees only its own files and processes.
# The other instances' config and state are hidden, the rest of the system
# is read-only, and it gets its own /tmp, IPC and PID namespaces.
# netns-exec drops CAP_SYS_ADMIN and the like, so it can't enter another
# instance's network namespace.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateIPC=yes
PrivatePIDs=yes
# The tun device, and the pseudo devices.
DevicePolicy=closed
DeviceAllow=/dev/net/tun rw
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectProc=invisible
TemporaryFileSystem=/etc/portitor /var/lib/portitor
BindReadOnlyPaths=/etc/portitor/instances/%i
BindReadOnlyPaths=/var/lib/portitor/instances/%i
# The instance's certificates (the server's), once there are any.
BindReadOnlyPaths=-/var/lib/portitor/certificates/%i
ReadWritePaths=/run/portitor
# The management socket, which the agent alone opens: only the instance's
# own directory, made by the agent, root's.
TemporaryFileSystem=/run/portitor/openvpn
BindPaths=/run/portitor/openvpn/%i
