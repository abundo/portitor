# radvd (IPv6 router advertisements) for one Portitor instance, inside the
# instance's network namespace. Started and reloaded by portitor-agent; do
# not enable by hand.
[Unit]
Description=IPv6 router advertisements for Portitor instance %i
After=portitor-agent.service
PartOf=portitor-agent.service

[Service]
Type=simple
ExecStart=/usr/bin/portitor-agent netns-exec %i -- /usr/sbin/radvd --nodaemon --logmethod stderr --config /etc/portitor/instances/%i/radvd.conf --pidfile /tmp/radvd.pid
# + : outside the sandbox, where $MAINPID is (PrivatePIDs gives each Exec*
# line a PID namespace of its own).
ExecReload=+/bin/kill -HUP $MAINPID
# The PID file is in the private /tmp: radvd is PID 1 (PrivatePIDs), so a
# stale one would read as "already running".
Restart=on-failure
RestartSec=5
RuntimeDirectory=portitor
RuntimeDirectoryPreserve=yes
# Multitenancy: an instance's daemon sees only its own files and processes.
# The other instances' config and state are hidden, the rest of the system
# is read-only, and it gets its own /tmp, IPC and PID namespaces.
# netns-exec drops CAP_SYS_ADMIN and the like, so it can't enter another
# instance's network namespace either.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateIPC=yes
PrivatePIDs=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectProc=invisible
TemporaryFileSystem=/etc/portitor /var/lib/portitor
BindReadOnlyPaths=/etc/portitor/instances/%i
BindReadOnlyPaths=/var/lib/portitor/instances/%i
ReadWritePaths=/run/portitor
