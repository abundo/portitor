# Static addresses on the lab networks (they have no podman IPAM).
[Unit]
Description=Lab: WAN (ISP side) and LAN addresses
Before=dnsmasq.service portitor-web.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/ip link set wan0 up
ExecStart=/usr/sbin/ip addr replace 198.51.100.1/24 dev wan0
ExecStart=/usr/sbin/ip link set lan0 up
ExecStart=/usr/sbin/ip addr replace 192.168.1.2/24 dev lan0

[Install]
WantedBy=multi-user.target
